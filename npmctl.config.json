{
    "schemaVersion":  1,
    "site":  "ssot-registry.com",
    "repository":  "groupsum/ssot-registry-com",
    "orchestrator":  "npmctl-pypi",
    "dns":  {
                "provider":  "namecheap",
                "zone":  "ssot-registry.com",
                "records":  [
                                {
                                    "type":  "A",
                                    "host":  "@",
                                    "value":  "SITE_SERVER_IP",
                                    "ttl":  300
                                },
                                {
                                    "type":  "A",
                                    "host":  "*",
                                    "value":  "SITE_SERVER_IP_SECRET",
                                    "ttl":  300
                                },
                                {
                                    "type":  "CNAME",
                                    "host":  "www",
                                    "value":  "ssot-registry.com",
                                    "ttl":  300
                                }
                            ],
                "providerPackage":  "npmctl-namecheap"
            },
    "deploy":  {
                   "target":  "self-hosted-docker",
                   "service":  "ssot-registry-com",
                   "composeFile":  "docker-compose.yaml",
                   "proxyManager":  {
                                        "provider":  "nginx-proxy-manager",
                                        "apiEndpoint":  "NPM_BASE_URL_SECRET"
                                    }
               },
    "npmctl":  {
                   "package":  "npmctl",
                   "dnsProviderPackage":  "npmctl-namecheap",
                   "installCommand":  "python -m pip install --upgrade npmctl==0.3.8 npmctl-namecheap==0.3.8",
                   "proxyManagerApiEndpoint":  "NPM_BASE_URL_SECRET"
               },
    "commands":  {
                     "install":  "npm ci",
                     "check":  "npm run check",
                     "build":  "npm run build",
                     "npmctl:install":  "python -m pip install --upgrade npmctl==0.3.8 npmctl-namecheap==0.3.8",
                     "npmctl:validate":  "npmctl validate desired-state",
                     "npmctl:schema":  "npmctl schema check",
                     "dns:doctor":  "npmctl dns doctor --provider namecheap",
                     "dns:plan":  "npmctl plan desired-state/dns.yaml --owner ssot-registry-com",
                     "dns:apply":  "npmctl apply desired-state/dns.yaml --owner ssot-registry-com",
                     "proxy:validate":  "npmctl validate desired-state/proxy.yaml",
                     "proxy:plan":  "npmctl plan desired-state/proxy.yaml --owner ssot-registry-com",
                     "proxy:apply":  "npmctl apply desired-state/proxy.yaml --owner ssot-registry-com"
                 }
}
